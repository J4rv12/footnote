# Copy to `.env` and fill in. `.env` is gitignored; this file is committed.
# Every name here must match a field on Settings in app/config.py.

# --- Secrets. Required at boot. ---
# From Footnote's own Console workspace, the one with the monthly spend limit.
ANTHROPIC_API_KEY=sk-ant-replace-me
# From https://dashboard.voyageai.com
VOYAGE_API_KEY=pa-replace-me

# --- Operational. Defaults in config.py are fine; override only to tune. ---
# ANTHROPIC_MODEL=claude-haiku-5-5
# VOYAGE_MODEL=voyage-4
# LOG_LEVEL=INFO
# MAX_CHUNK_WORDS=200
# CURRENT_EDITION=2026-27
